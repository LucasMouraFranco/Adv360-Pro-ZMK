#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        vim_shift_o {
            bindings = <&vim_shift_o>;
            key-positions = <46 25 66>;
            layers = <2>;
        };
    };

    macros {
        vim_dd: vim_dd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp LG(LS(RIGHT)) &kp LG(X) &kp BACKSPACE>;
            label = "VIM_DD";
        };

        vim_shift_o: vim_shift_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UP &kp LG(RIGHT) &kp ENTER>;
            label = "VIM_SHIFT_O";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1              &kp N2          &kp N3            &kp N4              &kp N5  &tog 1                                                                                                     &mo 3          &kp N6  &kp N7               &kp N8             &kp N9           &kp N0                  &kp MINUS
&kp TAB    &kp Q               &kp W           &kp E             &kp R               &kp T   &kp LS(LG(LA(LC(D))))                                                                                      &kp LS(LG(V))  &kp Y   &kp U                &kp I              &kp O            &kp P                   &kp BSLH
&kp ESC    &hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &kp G   &kp LS(LG(NUMBER_4))   &kp GRAVE     &kp CAPSLOCK              &kp CAPSLOCK           &mt LG(V) LG(C)      &kp LG(SPACE)  &kp H   &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_COMMAND SEMI  &kp SQT
&kp LSHFT  &kp Z               &kp X           &kp C             &kp V               &kp B                                        &mt LEFT_COMMAND TAB      &mt RIGHT_COMMAND TAB                                      &kp N   &kp M                &kp COMMA          &kp DOT          &kp FSLH                &kp RSHFT
&mo 2      &kp LEFT_ALT        &kp CAPS        &kp LEFT_CONTROL  &kp LEFT_COMMAND            &kp BACKSPACE          &lt 2 DELETE  &mt LEFT_CONTROL ESC      &mt LEFT_CONTROL ESC   &mt RIGHT_ALT ENTER  &kp SPACE              &kp RIGHT_COMMAND    &kp RIGHT_CONTROL  &kp LBKT         &kp RBKT                &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT              &kp RIGHT_ALT      &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp LEFT_COMMAND      &kp RIGHT_COMMAND                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp ESC               &kp CAPSLOCK       &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4            &kp F5            &kp F6  &tog 1                                      &mo 3   &kp F7     &kp F8                &kp F9                &kp F10    &kp F11    &kp F12
&trans  &trans  &trans  &trans            &trans            &trans  &none                                       &none   &kp LG(C)  &kp LG(Z)             &trans                &kp ENTER  &kp LG(V)  &trans
&trans  &trans  &trans  &vim_dd           &trans            &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT   &kp DOWN              &kp UP                &kp RIGHT  &trans     &trans
&trans  &trans  &trans  &trans            &kt LEFT_SHIFT    &trans                  &trans      &trans                  &trans     &trans                &trans                &trans     &trans     &trans
&trans  &trans  &trans  &kp LEFT_CONTROL  &kp LEFT_COMMAND          &trans  &trans  &trans      &trans  &trans  &trans             &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans     &trans     &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none         &none             &none                  &none            &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none         &none             &none                  &none            &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &kp C_VOL_DN  &kp C_PLAY_PAUSE  &kp LS(LA(LC(LG(O))))  &kp C_VOLUME_UP  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none         &none             &none                  &none            &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC        &bl BL_DEC             &none            &none  &none
            >;
        };

        vim {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
